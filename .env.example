# Salin berkas ini jadi .env, lalu jalankan: npm run set-password
#
# LETAKNYA PENTING. Berkas ini memuat hash sandi, rahasia penanda tangan cookie,
# dan sandi database. JANGAN ditaruh di dalam folder proyek kalau folder itu ada
# di OneDrive/Google Drive/Dropbox — ketiganya akan ikut naik ke cloud pihak
# ketiga tanpa ada gejala apa pun.
#
# Yang disarankan: C:/astra-data/.env (di sebelah folder data, di disk lokal).
# Server mencarinya berurutan:
#   1. variabel ACC_ENV_FILE          <- diatur start.bat dan systemd
#   2. isi berkas .env.path di proyek <- satu baris berisi path, bukan rahasia
#   3. DATA_DIR/.env
#   4. .env di dalam proyek           <- jalan terakhir
#
# Jangan di-commit, jangan dikirim lewat chat atau email.

# Hash sandi. Diisi otomatis oleh `npm run set-password` — jangan diketik manual.
PASSWORD_HASH=

# Kunci penanda tangan cookie sesi. Diisi otomatis sekali.
# Menggantinya membatalkan semua sesi yang sedang berjalan — itulah cara mengusir
# semua orang sekaligus kalau sandinya bocor.
SESSION_SECRET=

# Port aplikasi. Ubah kalau 3000 sudah dipakai program lain.
PORT=3000

# --- PostgreSQL + PostGIS ---
#
# PostGIS WAJIB, bukan tambahan. Rasio jangkauan dihitung di database dengan
# ST_Intersection/ST_Area; tanpa ekstensinya server menolak start.
#
# Dua database, sengaja dipisah:
#   astra            agregat penjualan, master pos/dealer, jejak impor, dan poligon
#                    kelurahan. Tanpa PII, boleh di-backup bebas.
#   astra_customers  nama dan alamat konsumen. DROP DATABASE ini = PII tercabut,
#                    aplikasinya tetap jalan penuh.
#
# Siapkan sekali, sebagai superuser:
#   CREATE ROLE astra LOGIN PASSWORD '<sandi panjang acak>' CREATEDB;
#   CREATE DATABASE astra OWNER astra ENCODING 'UTF8';
#   \c astra
#   CREATE EXTENSION postgis;
#
# CREATEDB dibutuhkan supaya aplikasi bisa membuat astra_customers sendiri waktu
# impor pertama yang menyertakan data konsumen, dan supaya `npm test` bisa membuat
# database ujinya sendiri.
#
# Supaya database uji ikut punya PostGIS tanpa perlu superuser tiap kali:
#   psql -U postgres -d template1 -c "CREATE EXTENSION postgis;"
#
# Tabelnya dibuat sendiri oleh aplikasi waktu start.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=astra
DB_PASSWORD=
DB_NAME=astra
DB_NAME_CUSTOMERS=astra_customers

# Letak folder data: berkas peta dan arsip Excel yang diunggah. Databasenya sendiri
# ada di PostgreSQL, bukan di sini.
#
# Sebaiknya di disk lokal, DI LUAR OneDrive/Google Drive/Dropbox. Berkas geo dibaca
# utuh waktu seed, dan folder yang sedang disinkronkan bisa menguncinya di tengah
# pembacaan.
#
# Pakai garis miring biasa (/), bukan garis miring terbalik (\), meskipun ini
# Windows. Node menerima keduanya, tapi garis miring terbalik gampang hilang waktu
# nilainya disalin lewat terminal atau chat — dan hilangnya diam-diam.
DATA_DIR=C:/astra-data

# Isi 1 hanya kalau aplikasi sudah dilayani lewat HTTPS.
# Kalau dinyalakan tanpa HTTPS, cookie tidak akan pernah terkirim dan tidak ada yang
# bisa login.
COOKIE_SECURE=0

# --- HTTPS (opsional) ---
#
# Diisi HANYA kalau aplikasi ini melayani TLS sendiri. Di VPS, biasanya Caddy atau
# Nginx di depan yang mengurus sertifikat dan aplikasi ini tetap HTTP di belakangnya
# — dalam keadaan itu dua baris ini dibiarkan kosong.
#
# Harus diisi dua-duanya atau tidak sama sekali. Kalau diisi tapi berkasnya tidak
# ketemu, server MENOLAK start — lebih baik daripada diam-diam turun ke HTTP.
#
# Jangan memakai sertifikat yang ditandatangani sendiri untuk pengguna sungguhan:
# layar peringatan merah mengajari orang menekan "lanjutkan saja".
# SSL_CERT=C:/astra-data/tls/cert.pem
# SSL_KEY=C:/astra-data/tls/key.pem
